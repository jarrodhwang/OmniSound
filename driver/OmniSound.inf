[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=10/02/2026,0.2.0.0
CatalogFile=OmniSound.cat
PnpLockdown=1

[Manufacturer]
%Provider%=Models,NTamd64.10.0...22000
[Models.NTamd64.10.0...22000]
%DeviceName%=OmniSound,OmniSound\Group
[SourceDisksNames]
1=%DiskName%,,,
[SourceDisksFiles]
OmniSoundAudio.sys=1
[DestinationDirs]
DriverCopy=13
[DriverCopy]
OmniSoundAudio.sys

[OmniSound.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=DriverCopy
AddReg=DriverSettings
[DriverSettings]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,OmniSoundAudio.sys
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceName%
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Description,,%DeviceName%
[OmniSound.NT.Services]
AddService=OmniSoundAudio,0x00000002,AudioService
[AudioService]
DisplayName=%DeviceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\OmniSoundAudio.sys
[OmniSound.NT.Wdf]
KmdfService=OmniSoundAudio,WdfSettings
[WdfSettings]
KmdfLibraryVersion=1.15

[OmniSound.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,WaveOmniSound,WaveInterface
AddInterface=%KSCATEGORY_RENDER%,WaveOmniSound,WaveInterface
AddInterface=%KSCATEGORY_REALTIME%,WaveOmniSound,WaveInterface
AddInterface=%KSCATEGORY_AUDIO%,TopologyOmniSound,TopologyInterface
AddInterface=%KSCATEGORY_TOPOLOGY%,TopologyOmniSound,TopologyInterface
[WaveInterface]
AddReg=WaveInterfaceSettings
[WaveInterfaceSettings]
HKR,,CLSID,,%ProxyCLSID%
HKR,,FriendlyName,,%DeviceName%
[TopologyInterface]
AddReg=TopologyInterfaceSettings
[TopologyInterfaceSettings]
HKR,,CLSID,,%ProxyCLSID%
HKR,,FriendlyName,,%DeviceName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,1
HKR,EP\0,%PKEY_AudioEndpoint_PhysicalSpeakers%,0x00010001,0x0000063F

[Strings]
Provider="OmniSound"
DeviceName="OmniSound Group"
DiskName="OmniSound Driver"
