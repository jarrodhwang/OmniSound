<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PowerShellExe Condition="'$(PowerShellExe)' == ''">pwsh.exe</PowerShellExe>
  </PropertyGroup>
  <Target Name="Build">
    <Exec Command="&quot;$(PowerShellExe)&quot; -NoProfile -File &quot;$(MSBuildThisFileDirectory)..\tools\Build-Driver.ps1&quot; -Restore" />
  </Target>
</Project>
